# Copy to .env and fill in. Never commit .env.
# Free option (default): get a key at https://aistudio.google.com/apikey (no billing needed)
GEMINI_API_KEY=

# Only if you switch llm.provider to anthropic (paid)
ANTHROPIC_API_KEY=

# Absolute path to your Obsidian vault folder (the folder that contains .obsidian)
OBSIDIAN_VAULT_PATH=/Users/you/Documents/ObsidianVault

# Notion: create an internal integration at https://www.notion.so/my-integrations
# then share your database (or its parent page) with that integration.
NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=
